 \n\n    def forward(self,ip):\n        batch,num_token = ip.shape\n        tok_embedding = self.tok_emb(ip)\n        pos_embedding = self.pos_emb(torch.arange(num_token))\n        x = tok_embedding + pos_embedding\n        x = self.drop_emb(x)\n        x = self.trf_blocks(x)\n        x = self.final_norm(x)\n        logits = self.out_head(x)\n        return logits","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T06:09:34.069341Z","iopub.execute_input":"2026-11-16T06:09:34.069681Z","iopub.status.idle":"2026-11-16T06:09:39.166564Z","shell.execute_reply.started":"2026-11-16T06:09:34.069646Z","shell.execute_reply":"2026-11-16T06:09:39.164108Z"}},"outputs":[],"execution_count":2},{"cell_type":"code","source":"# DummyTransformerBlock class\n\nclass DummyTransformerBlock(torch.nn.Module):\n    def __init__(self,cfg):\n        super().__init__()\n\n    def forward(self,x):\n        return x","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T06:10:01.17558Z","iopub.execute_input":"2026-11-16T06:10:01.176325Z","iopub.status.idle":"2026-11-16T06:10:01.185256Z","shell.execute_reply.started":"2026-11-16T06:10:01.176281Z","shell.execute_reply":"2026-11-16T06:10:01.183897Z"}},"outputs":[],"execution_count":7},{"cell_type":"code","source":"# DummyLayer Normalization \n\nclass DummyLayerNorm(torch.nn.Module):\n    def __init__(self,normalized_shape,eps = 1e-5):\n        super().__init__()\n\n    def forward(self,x):\n        return x","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-16T06:10:02.192189Z","iopub.execute_input":"2026-11-16T06:10:02.192631Z","iopub.status.idle":"2026-11-16T06:10:02.202665Z","shell.execute_reply.started":"2026-11-16T06:10:02.192592Z","shell.execute_reply":"2026-11-16T06:10:02.201306Z"}},"outputs":[],"execution_count":8},{"cell_type":"code","source":"# Test dataset\nimport tiktoken\ntxt1 = \"Every effort moves you\"\ntxt2 = \"Every day holds a\"\n\ntokenizer = tiktoken.get_encoding(\"gpt2\"