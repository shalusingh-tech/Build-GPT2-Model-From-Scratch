{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"# AIM: Implementing a GPT model from scratch to generate text\n\n# DOB: 31-10-2026\n\n# Author: Shalu Singh","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19"}},{"cell_type":"markdown","source":"### Q.1) What Is the Meaning of Parameters in Deep Learning and LLMs?\n\n**Answer:**\n\n1. **Definition:** Parameters refer to the trainable weights and biases of a model.\n\n2. **Optimization:** These parameters are the internal variables of the model that are adjusted and optimized during the training process to minimize a specific loss function.\n\n3. **Learning from Data:** This optimization process allows the model to learn patterns and relationships from the training data, improving its predictions over time.\n\n---\n\n**Key Takeaway:**\n\n> Parameters are the values a model learns during training by minimizing the loss function.","metadata":{}},{"cell_type":"markdown","source":"### Q.2) What Are the Similarities and Differences Between GPT-2 and GPT-3?\n\n**Answer:**\n\n**1. Similarity:**\n- Both GPT-2 and GPT-3 are based on the same fundamental **Transformer decoder architecture**.\n\n**2. Differences:**\n- **Number of Parameters:** GPT-2 has up to 1.5 billion parameters, whereas GPT-3 has 175 billion parameters.\n- **Training Data:** GPT-3 was trained on a larger dataset compared to GPT-2.\n\n---\n\n**Key Takeaway:**\n\n> GPT-2 and GPT-3 share the same fundamental architecture, but GPT-3 significantly scales up the model size and training data.","metadata":{}},{"cell_type":"code","source":"# GPT-2 Config size\nGPT2_CONFIG = {\n    \"vocab_size\": 50257, # Vocabulary size\n    \"context_length\": 1024, # Context length\n    \"emb_dim\": 768, # Embedding dimension\n    \"n_heads\": 12, # No. of attention heads\n    \"n_layers\": 12, # No. of layers\n    \"drop_rate\": 0.1, # Dropout rate\n    \"qkv_bias\": False # Query-Key-Value bias\n}","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:32.366521Z","iopub.execute_input":"2026-11-17T08:03:32.366785Z","iopub.status.idle":"2026-11-17T08:03:32.394543Z","shell.execute_reply.started":"2026-11-17T08:03:32.36676Z","shell.execute_reply":"2026-11-17T08:03:32.393404Z"}},"outputs":[],"execution_count":1},{"cell_type":"markdown","source":"### Order of Building LLM Architecture\n\n![image.png](attachment:cc77aaf7-8caf-4ffc-851b-344027d7b2bd.png)","metadata":{},"attachments":{"cc77aaf7-8caf-4ffc-851b-344027d7b2bd.png":{"image/png":""}}},{"cell_type":"markdown","source":"### GPT-2 Architecture\n\n![image.png](attachment:bbe84e30-e7e1-40fd-97e3-2c0feb96f9bb.png)","metadata":{},"attachments":{"bbe84e30-e7e1-40fd-97e3-2c0feb96f9bb.png":{"image/png":""}}},{"cell_type":"markdown","source":"#### DummyGPTModel architecture ","metadata":{}},{"cell_type":"code","source":"# Dummy GPT Model architecture\nimport torch\n\nclass DummyGPTModel(torch.nn.Module):\n    def __init__(self,cfg):\n        super().__init__()\n        self.tok_emb = torch.nn.Embedding(cfg[\"vocab_size\"],cfg[\"emb_dim\"])\n        self.pos_emb = torch.nn.Embedding(cfg[\"context_length\"],cfg[\"emb_dim\"])\n        self.drop_emb = torch.nn.Dropout(cfg[\"drop_rate\"])\n        self.trf_blocks = torch.nn.Sequential(*[DummyTransformerBlock(cfg) for _ in range(cfg[\"n_layers\"])])\n        self.final_norm = DummyLayerNorm(cfg[\"emb_dim\"])\n        self.out_head = torch.nn.Linear(cfg[\"emb_dim\"],cfg[\"vocab_size\"],bias = False)\n        \n\n    def forward(self,ip):\n        batch,num_token = ip.shape\n        tok_embedding = self.tok_emb(ip)\n        pos_embedding = self.pos_emb(torch.arange(num_token))\n        x = tok_embedding + pos_embedding\n        x = self.drop_emb(x)\n        x = self.trf_blocks(x)\n        x = self.final_norm(x)\n        logits = self.out_head(x)\n        return logits","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:32.39694Z","iopub.execute_input":"2026-11-17T08:03:32.397626Z","iopub.status.idle":"2026-11-17T08:03:37.220915Z","shell.execute_reply.started":"2026-11-17T08:03:32.397568Z","shell.execute_reply":"2026-11-17T08:03:37.21966Z"}},"outputs":[],"execution_count":2},{"cell_type":"code","source":"# DummyTransformerBlock class\n\nclass DummyTransformerBlock(torch.nn.Module):\n    def __init__(self,cfg):\n        super().__init__()\n\n    def forward(self,x):\n        return x","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:37.222404Z","iopub.execute_input":"2026-11-17T08:03:37.222817Z","iopub.status.idle":"2026-11-17T08:03:37.228404Z","shell.execute_reply.started":"2026-11-17T08:03:37.22279Z","shell.execute_reply":"2026-11-17T08:03:37.227359Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"# DummyLayer Normalization \n\nclass DummyLayerNorm(torch.nn.Module):\n    def __init__(self,normalized_shape,eps = 1e-5):\n        super().__init__()\n\n    def forward(self,x):\n        return x","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:37.229696Z","iopub.execute_input":"2026-11-17T08:03:37.230059Z","iopub.status.idle":"2026-11-17T08:03:37.26742Z","shell.execute_reply.started":"2026-11-17T08:03:37.230021Z","shell.execute_reply":"2026-11-17T08:03:37.266253Z"}},"outputs":[],"execution_count":4},{"cell_type":"code","source":"# Test dataset\nimport tiktoken\ntxt1 = \"Every effort moves you\"\ntxt2 = \"Every day holds a\"\n\ntokenizer = tiktoken.get_encoding(\"gpt2\")\nbatch = []\nbatch.append(torch.tensor(tokenizer.encode(txt1)))\nbatch.append(torch.tensor(tokenizer.encode(txt2)))\nbatch = torch.stack(batch,dim = 0)\nbatch.shape,batch","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:37.268748Z","iopub.execute_input":"2026-11-17T08:03:37.269264Z","iopub.status.idle":"2026-11-17T08:03:39.484469Z","shell.execute_reply.started":"2026-11-17T08:03:37.269201Z","shell.execute_reply":"2026-11-17T08:03:39.483023Z"}},"outputs":[{"execution_count":5,"output_type":"execute_result","data":{"text/plain":"(torch.Size([2, 4]),\n tensor([[6109, 3626, 6100,  345],\n         [6109, 1110, 6622,  257]]))"},"metadata":{}}],"execution_count":5},{"cell_type":"code","source":"# Calling DummyGptModel class \n\ngpt = DummyGPTModel(GPT2_CONFIG)\ncontext_vec = gpt(batch)\ncontext_vec.shape,context_vec","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:39.485833Z","iopub.execute_input":"2026-11-17T08:03:39.486199Z","iopub.status.idle":"2026-11-17T08:03:40.645978Z","shell.execute_reply.started":"2026-11-17T08:03:39.486157Z","shell.execute_reply":"2026-11-17T08:03:40.64486Z"}},"outputs":[{"execution_count":6,"output_type":"execute_result","data":{"text/plain":"(torch.Size([2, 4, 50257]),\n tensor([[[ 0.8298,  0.7373, -0.1603,  ..., -0.0190,  0.8649,  0.0825],\n          [ 0.2103, -0.4437,  0.6841,  ..., -1.2013, -0.6605, -1.1366],\n          [-0.1147,  0.5047,  0.1376,  ..., -0.1923,  0.3169, -0.5539],\n          [-0.3347,  0.6481,  1.7010,  ..., -0.7799,  1.3050,  0.0067]],\n \n         [[ 0.7460,  0.1941,  0.4355,  ...,  0.0682,  0.2177,  0.2291],\n          [ 0.6087,  0.4084,  1.5308,  ..., -0.2842,  0.2893, -0.2351],\n          [-0.5061,  0.5381,  0.3727,  ..., -1.5149, -0.2054,  0.9029],\n          [-0.5709,  0.5220,  0.4660,  ..., -0.7554, -0.3598,  0.2644]]],\n        grad_fn=<UnsafeViewBackward0>))"},"metadata":{}}],"execution_count":6},{"cell_type":"markdown","source":"### Q.1) What Is the Problem with Training Deep Neural Networks? How Does Layer Normalization Mitigate It?\n\n**Answer:**\n\n1. **Vanishing and Exploding Gradients:** Training deep neural networks with many layers can be challenging due to the problems of vanishing and exploding gradients.\n\n2. **Unstable Training:** These problems lead to unstable training dynamics, making it difficult for the network to update its trainable weights (parameters) effectively to minimize the loss function.\n\n3. **Why Layer Normalization?** We use Layer Normalization (LayerNorm) to improve training stability and speed up convergence.\n\n4. **Definition of Layer Normalization:** The main idea behind Layer Normalization is to normalize the activations (outputs) of a neural network layer so that they have a mean of 0 and a variance of 1.\n\n   **Mathematical Formula:**\n\n   $$\n   \\mu = \\frac{1}{d}\\sum_{i=1}^{d}x_i\n   $$\n\n   $$\n   \\sigma^2 = \\frac{1}{d}\\sum_{i=1}^{d}(x_i-\\mu)^2\n   $$\n\n   $$\n   \\hat{x}_i = \\frac{x_i-\\mu}{\\sqrt{\\sigma^2+\\epsilon}}\n   $$\n\n   Where:\n   - $x_i$ = Input activation\n   - $\\mu$ = Mean of the activations\n   - $\\sigma^2$ = Variance of the activations\n   - $\\epsilon$ = Small constant added for numerical stability\n   - $d$ = Number of features in the input\n\n5. **Benefits:** This normalization helps maintain consistent activation scales across layers, improving training stability and often speeding up convergence.\n\n6. **LayerNorm in GPT-2:** In GPT-2, Layer Normalization is applied before and after the Multi-Head Attention module and before the Feed-Forward Network in each Transformer block.\n\n---\n\n**Key Takeaway:**\n\n> Layer Normalization stabilizes the distribution of activations by normalizing them to approximately zero mean and unit variance, helping deep neural networks train more reliably.\n\n---\n\n![Screenshot 2026-11-16 at 12.22.11 PM.png](attachment:a60d187a-8476-4a39-ab47-6e695383293e.png)","metadata":{},"attachments":{"a60d187a-8476-4a39-ab47-6e695383293e.png":{"image/png":""}}},{"cell_type":"code","source":"# Effect of layer normalization\ntorch.manual_seed(123)\nbatch_example = torch.randn(2,5)\nlayer = torch.nn.Sequential(torch.nn.Linear(5,6),torch.nn.ReLU())\nout = layer(batch_example)\nout.shape,out","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:40.649095Z","iopub.execute_input":"2026-11-17T08:03:40.649542Z","iopub.status.idle":"2026-11-17T08:03:40.687602Z","shell.execute_reply.started":"2026-11-17T08:03:40.649512Z","shell.execute_reply":"2026-11-17T08:03:40.686508Z"}},"outputs":[{"execution_count":7,"output_type":"execute_result","data":{"text/plain":"(torch.Size([2, 6]),\n tensor([[0.2260, 0.3470, 0.0000, 0.2216, 0.0000, 0.0000],\n         [0.2133, 0.2394, 0.0000, 0.5198, 0.3297, 0.0000]],\n        grad_fn=<ReluBackward0>))"},"metadata":{}}],"execution_count":7},{"cell_type":"markdown","source":"![Screenshot 2026-11-16 at 12.36.16 PM.png](attachment:8f20e69c-7cca-4a72-9b6c-8c41ca11a2d4.png)","metadata":{},"attachments":{"8f20e69c-7cca-4a72-9b6c-8c41ca11a2d4.png":{"image/png":""}}},{"cell_type":"code","source":"# Checknig the mean and variance of output\nmean = out.mean(dim = -1,keepdim = True) # keepdim: ensures that the output tensor retains the same no. of dimension as input tensor\nvar = out.var(dim = -1,keepdim = True)\nprint(\"Mean:\\n\",mean)\nprint(\"Varianc:\\n\",var)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:40.688872Z","iopub.execute_input":"2026-11-17T08:03:40.689349Z","iopub.status.idle":"2026-11-17T08:03:40.718274Z","shell.execute_reply.started":"2026-11-17T08:03:40.689293Z","shell.execute_reply":"2026-11-17T08:03:40.717361Z"}},"outputs":[{"name":"stdout","text":"Mean:\n tensor([[0.1324],\n        [0.2170]], grad_fn=<MeanBackward1>)\nVarianc:\n tensor([[0.0231],\n        [0.0398]], grad_fn=<VarBackward0>)\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"# Applying layer normalization to ouput\n# Layer Normazliation: The operation consist of subtracting the mean and dividing by the standard deviation\ntorch.set_printoptions(sci_mode = False)\nout_norm = (out-mean)/torch.sqrt(var)\nmean = out_norm.mean(dim = -1, keepdim = True)\nvar = out_norm.var(dim = -1,keepdim = True)\nprint(\"Mean:\\n\",mean)\nprint(\"Variance:\\n\",var)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:40.719584Z","iopub.execute_input":"2026-11-17T08:03:40.719943Z","iopub.status.idle":"2026-11-17T08:03:40.748815Z","shell.execute_reply.started":"2026-11-17T08:03:40.719905Z","shell.execute_reply":"2026-11-17T08:03:40.747254Z"}},"outputs":[{"name":"stdout","text":"Mean:\n tensor([[0.0000],\n        [0.0000]], grad_fn=<MeanBackward1>)\nVariance:\n tensor([[1.0000],\n        [1.0000]], grad_fn=<VarBackward0>)\n","output_type":"stream"}],"execution_count":9},{"cell_type":"markdown","source":"#### Implementing Layer Normalization Class","metadata":{}},{"cell_type":"code","source":"class LayerNorm(torch.nn.Module):\n    def __init__(self,emb_dim):\n        super().__init__()\n        self.eps = 1e-5    # the epsilon is added to variance to prevent division by zero\n        self.scale = torch.nn.Parameter(torch.ones(emb_dim))\n        self.shift = torch.nn.Parameter(torch.zeros(emb_dim))  # scale and shift are two training parameters which model optmized d\n\n    def forward(self,x):\n        mean = x.mean(dim = -1, keepdim = True)\n        var = x.var(dim = -1,keepdim = True,unbiased=False)\n        norm_x = (x-mean)/ torch.sqrt(var + self.eps)\n        return self.scale * norm_x + self.shift","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:40.750249Z","iopub.execute_input":"2026-11-17T08:03:40.750857Z","iopub.status.idle":"2026-11-17T08:03:40.758874Z","shell.execute_reply.started":"2026-11-17T08:03:40.750792Z","shell.execute_reply":"2026-11-17T08:03:40.757408Z"}},"outputs":[],"execution_count":10},{"cell_type":"code","source":"# Calling layer normalization class\nln = LayerNorm(emb_dim = 5)\nnorm_out = ln(batch_example)\nnorm_out.shape,norm_out","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:40.760563Z","iopub.execute_input":"2026-11-17T08:03:40.761071Z","iopub.status.idle":"2026-11-17T08:03:40.78892Z","shell.execute_reply.started":"2026-11-17T08:03:40.761026Z","shell.execute_reply":"2026-11-17T08:03:40.787453Z"}},"outputs":[{"execution_count":11,"output_type":"execute_result","data":{"text/plain":"(torch.Size([2, 5]),\n tensor([[ 0.5528,  1.0693, -0.0223,  0.2656, -1.8654],\n         [ 0.9087, -1.3767, -0.9564,  1.1304,  0.2940]], grad_fn=<AddBackward0>))"},"metadata":{}}],"execution_count":11},{"cell_type":"code","source":"# Checking mean and variance of layer normalization\nmean = norm_out.mean(dim = -1, keepdim = True)\nvar = norm_out.var(dim = -1, keepdim = True,unbiased = False)\nprint(\"Mean:\\n\",mean)\nprint(\"Varaince:\\n\",var)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:40.790326Z","iopub.execute_input":"2026-11-17T08:03:40.79077Z","iopub.status.idle":"2026-11-17T08:03:40.829991Z","shell.execute_reply.started":"2026-11-17T08:03:40.790743Z","shell.execute_reply":"2026-11-17T08:03:40.828577Z"}},"outputs":[{"name":"stdout","text":"Mean:\n tensor([[-0.0000],\n        [ 0.0000]], grad_fn=<MeanBackward1>)\nVaraince:\n tensor([[1.0000],\n        [1.0000]], grad_fn=<VarBackward0>)\n","output_type":"stream"}],"execution_count":12},{"cell_type":"markdown","source":"#### Q.2) Why do we use GELU (Gaussian Error Linear Unit) activation function in the FeedForward Layer?\n\n**Ans:**\n\n1. **Smooth Activation:** GELU provides a smooth activation function, which can lead to better optimization during training by allowing more gradual adjustments to model parameters.\n\n2. **Comparison with ReLU:** Unlike GELU, ReLU has a sharp corner at zero. GELU's smooth curve provides a gradual transition, which can be beneficial during optimization, especially in deep or complex networks.\n\n3. **Non-zero Output for Negative Inputs:** ReLU outputs zero for all negative inputs, whereas GELU allows small, non-zero outputs for negative inputs. This means neurons receiving negative inputs can still contribute to the learning process, although their contribution is reduced compared to positive inputs.\n\n---\n###### GELU activation function used in GPT-2\n![Screenshot 2026-11-16 at 1.50.31 PM.png](attachment:02416213-fc38-4f2e-bc4d-2325e36c4e5c.png)\n\n---\n###### GELU VS ReLU activation function\n\n![Screenshot 2026-11-16 at 1.51.24 PM.png](attachment:62a53527-bae2-406e-ac29-f14495d225e6.png)","metadata":{},"attachments":{"02416213-fc38-4f2e-bc4d-2325e36c4e5c.png":{"image/png":""},"62a53527-bae2-406e-ac29-f14495d225e6.png":{"image/png":""}}},{"cell_type":"markdown","source":"##### Implementing GELU activation class","metadata":{}},{"cell_type":"code","source":"class GELU(torch.nn.Module):\n    def __init__(self):\n        super().__init__()\n\n    def forward(self,x):\n       return 0.5 * x * (1 + torch.tanh(torch.sqrt(torch.tensor(2/torch.pi)) * (x + 0.044715 * torch.pow(x,3))))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:40.831379Z","iopub.execute_input":"2026-11-17T08:03:40.831743Z","iopub.status.idle":"2026-11-17T08:03:40.838511Z","shell.execute_reply.started":"2026-11-17T08:03:40.831707Z","shell.execute_reply":"2026-11-17T08:03:40.837391Z"}},"outputs":[],"execution_count":13},{"cell_type":"code","source":"# Calling GELU activation function against RELU activation function\nimport matplotlib.pyplot as plt\ngelu, relu = GELU(), torch.nn.ReLU()\nx = torch.linspace(-3, 3, 100)\ny_gelu, y_relu = gelu(x), relu(x)\nplt.figure(figsize=(8, 3))\nfor i, (y, label) in enumerate(zip([y_gelu, y_relu], [\"GELU\", \"ReLU\"]), 1):\n    plt.subplot(1, 2, i)\n    plt.plot(x, y)\n    plt.title(f\"{label} activation function\")\n    plt.xlabel(\"x\")\n    plt.ylabel(f\"{label}(x)\")\n    plt.grid(True)\n    plt.tight_layout()\n    plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:40.839839Z","iopub.execute_input":"2026-11-17T08:03:40.840528Z","iopub.status.idle":"2026-11-17T08:03:41.293355Z","shell.execute_reply.started":"2026-11-17T08:03:40.840485Z","shell.execute_reply":"2026-11-17T08:03:41.292376Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 800x300 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 640x480 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":14},{"cell_type":"markdown","source":"#### Q.3) What is the use of the FeedForward Network Module in GPT-2?\n\n**Ans:**\n\n1. **Enhancing Learning Capacity:** The FeedForward Network plays an important role in enhancing the model's ability to learn complex patterns and representations from the input data.\n\n2. **Expanding Embedding Dimensions:** The input and output dimensions of the FeedForward Network are the same. However, internally, it expands the embedding dimension into a higher-dimensional space through a linear layer, allowing the model to learn richer representations. It then projects the representation back to the original embedding dimension.\n\n---\n![Screenshot 2026-11-16 at 2.16.43 PM.png](attachment:2a3fad6f-d0f1-4da4-b86e-8a5a91a92664.png)\n\n---\n![Screenshot 2026-11-16 at 2.16.26 PM.png](attachment:77efede6-27f3-420c-855f-c37e4b3b4eed.png)\n","metadata":{},"attachments":{"77efede6-27f3-420c-855f-c37e4b3b4eed.png":{"image/png":""},"2a3fad6f-d0f1-4da4-b86e-8a5a91a92664.png":{"image/png":""}}},{"cell_type":"markdown","source":"#### Implementing FeedForward class","metadata":{}},{"cell_type":"code","source":"class FeedForward(torch.nn.Module):\n    def __init__(self,cfg):\n        super().__init__()\n        self.layer = torch.nn.Sequential(torch.nn.Linear(cfg[\"emb_dim\"],cfg[\"emb_dim\"]*4),\n                                         GELU(),\n                                         torch.nn.Linear(cfg[\"emb_dim\"]*4,cfg[\"emb_dim\"]))\n\n    def forward(self,x):\n        return self.layer(x)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:41.29457Z","iopub.execute_input":"2026-11-17T08:03:41.2954Z","iopub.status.idle":"2026-11-17T08:03:41.302473Z","shell.execute_reply.started":"2026-11-17T08:03:41.295359Z","shell.execute_reply":"2026-11-17T08:03:41.301499Z"}},"outputs":[],"execution_count":15},{"cell_type":"code","source":"# Calling FeedForward class instance\nbatch_ip2 = torch.rand(2,GPT2_CONFIG[\"emb_dim\"])\nff = FeedForward(GPT2_CONFIG)\nout = ff(batch_ip2)\nout.shape","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:03:41.303831Z","iopub.execute_input":"2026-11-17T08:03:41.304268Z","iopub.status.idle":"2026-11-17T08:03:41.390207Z","shell.execute_reply.started":"2026-11-17T08:03:41.304223Z","shell.execute_reply":"2026-11-17T08:03:41.389342Z"}},"outputs":[{"execution_count":16,"output_type":"execute_result","data":{"text/plain":"torch.Size([2, 768])"},"metadata":{}}],"execution_count":16},{"cell_type":"markdown","source":"### Q.3) What is the use of Shortcut Connections in Deep Neural Networks?\n\n**Ans:**\n\n1. **Definition:** A shortcut connection lets the input skip one or more layers and be added back to the layer output.\n2. **Mitigates vanishing gradients:** Gradients shrink as they move backward through many layers, so earlier layers struggle to learn.\n3. **Shorter path:** The shortcut gives gradients a direct route around the layers.\n4. **Preserves gradient flow:** This makes deeper networks easier to train.\n\n### Diagram\n\n![image.png](attachment:72f66853-1146-4f20-9a3a-12fc7697bf8e.png)\n\n### Formula\n\n$$\n\\text{Output} = F(x) + x\n$$\n\n- `x` = original input\n- `F(x)` = output of the intermediate layers\n- `F(x) + x` = final output after adding the shortcut\n\n**Key takeaway:** Shortcut connections let information and gradients bypass intermediate layers, which helps deep networks train more effectively.\n\n**In GPT-2:** Each Transformer block has a shortcut around the Multi-Head Attention block and another around the FeedForward block.","metadata":{},"attachments":{"72f66853-1146-4f20-9a3a-12fc7697bf8e.png":{"image/png":""}}},{"cell_type":"markdown","source":"##### A neural network to illustrate shortcut connections","metadata":{}},{"cell_type":"code","source":"class ShortcutConnection(torch.nn.Module):\n    def __init__(self,layer_sizes,use_shortcut):\n        super().__init__()\n        self.use_shortcut = use_shortcut\n        self.layers = torch.nn.ModuleList(\n                                    [\n                                        torch.nn.Sequential(torch.nn.Linear(layer_sizes[0],layer_sizes[1]),GELU()), # layer-1\n                                        torch.nn.Sequential(torch.nn.Linear(layer_sizes[1],layer_sizes[2]),GELU()), # layer-2\n                                        torch.nn.Sequential(torch.nn.Linear(layer_sizes[2],layer_sizes[3]),GELU()), # layer-3\n                                        torch.nn.Sequential(torch.nn.Linear(layer_sizes[3],layer_sizes[4]),GELU()), # layer-4\n                                        torch.nn.Sequential(torch.nn.Linear(layer_sizes[4],layer_sizes[5]),GELU())  # layer-5                                    \n                                    ])\n\n    def forward(self,x):\n        for layer in self.layers:\n            out_x = layer(x)\n            if self.use_shortcut and x.shape == out_x.shape:\n                x = x + out_x\n            else:\n                x = out_x\n\n        return x\n\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:11:22.174333Z","iopub.execute_input":"2026-11-17T08:11:22.175484Z","iopub.status.idle":"2026-11-17T08:11:22.183703Z","shell.execute_reply.started":"2026-11-17T08:11:22.175403Z","shell.execute_reply":"2026-11-17T08:11:22.1824Z"}},"outputs":[],"execution_count":22},{"cell_type":"code","source":"layer_sizes = [3,3,3,3,3,1]\nsample_input = torch.tensor([[1.,0.,-1.]])\ntorch.manual_seed(123)\nmodel_without_shortcut = ShortcutConnection(layer_sizes,False)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:11:23.910136Z","iopub.execute_input":"2026-11-17T08:11:23.91141Z","iopub.status.idle":"2026-11-17T08:11:23.922493Z","shell.execute_reply.started":"2026-11-17T08:11:23.911367Z","shell.execute_reply":"2026-11-17T08:11:23.921192Z"}},"outputs":[],"execution_count":23},{"cell_type":"code","source":"def print_gradients(model, x):\n    output = model(x)\n    target = torch.tensor([[0.]])\n    loss = nn.MSELoss()\n    loss = loss(output, target)\n    loss.backward()\n\nfor name, param in model_without_shortcut.named_parameters():\n    if 'weight' in name:\n        print(f\"{name} has gradient mean of {param.grad.abs().mean().item()}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T08:16:34.080761Z","iopub.execute_input":"2026-11-17T08:16:34.081924Z","iopub.status.idle":"2026-11-17T08:16:34.091531Z","shell.execute_reply.started":"2026-11-17T08:16:34.081888Z","shell.execute_reply":"2026-11-17T08:16:34.090029Z"}},"outputs":[{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mAttributeError\u001b[0m                            Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_48/2986599644.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m      8\u001b[0m \u001b[0;32mfor\u001b[0m \u001b[0mname\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mparam\u001b[0m \u001b[0;32min\u001b[0m \u001b[0mmodel_without_shortcut\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mnamed_parameters\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m      9\u001b[0m     \u001b[0;32mif\u001b[0m \u001b[0;34m'weight'